// Notes-style three-pane demo: formatting + folder actions live in the window toolbar (title bar); content is list | editor.
// From this directory: `npm install` then `npm run dev`.

import { macos, SidebarWindow, VisualEffect, useState, useEffect } from "tish:macos"

// --- Glass: sidebar uses `behindWindow` (needs non-opaque window in host) + full layer opacity.
// List/editor panes use `contentBackground` + `withinWindow` so blur reads against the split, not flat grey.
let GLASS_OPACITY = 1.0
let SIDEBAR_EFFECT_MATERIAL = "sidebar"
let SIDEBAR_EFFECT_BLENDING = "behindWindow"
let PANE_EFFECT_MATERIAL = "contentBackground"
let PANE_EFFECT_BLENDING = "withinWindow"
// Translucent pink-tinted lift behind selected row (#RRGGBBAA)
let ROW_SELECTED_BG = "#ff4b9128"
let ACCENT_PINK = "#ff4b91"
let MUTED_TEXT = "#6e6e73"
let SECTION_HEADER_COLOR = "#8b8b90"
// Fixed leading/trailing columns: proportional `weights` alone widens the icon→label gap as the sidebar grows.
let NOTES_SIDEBAR_COL_WIDTHS = [20, 0, 46]
let NOTES_SIDEBAR_WEIGHTS = [1, 1, 1]
let SIDEBAR_SCROLL_PL = 8
let SIDEBAR_ROW_INSET = 5

fn folder_row_bg(sel, i) {
  if (sel === i) {
    return ROW_SELECTED_BG
  }
  return "transparent"
}

fn folder_icon_name(sel, idx) {
  if (sel === idx) {
    return "folder.fill"
  }
  return "folder"
}

fn folder_icon_tint(sel, i) {
  if (sel === i) {
    return ACCENT_PINK
  }
  return "label"
}

fn folder_label_color(sel, i) {
  if (sel === i) {
    return ACCENT_PINK
  }
  return "label"
}

fn notes_sidebar_folder_row_style(sel, idx) {
  return {
    paddingTop: 8,
    paddingBottom: 8,
    paddingLeft: SIDEBAR_ROW_INSET,
    paddingRight: SIDEBAR_ROW_INSET,
    borderRadius: 9,
    backgroundColor: folder_row_bg(sel, idx),
    alignItems: "center",
  }
}

fn NotesSidebarFolderRow(sel, idx, label, countStr, onPick) {
  return (
    <Row
      columnWidths={NOTES_SIDEBAR_COL_WIDTHS}
      weights={NOTES_SIDEBAR_WEIGHTS}
      onClick={onPick}
      style={notes_sidebar_folder_row_style(sel, idx)}
    >
      <Image
        src={folder_icon_name(sel, idx)}
        symbol={true}
        height={16}
        symbolScale="small"
        tint={folder_icon_tint(sel, idx)}
      />
      <Text style={{ fontSize: 13, color: folder_label_color(sel, idx) }}>{label}</Text>
      <Text style={{ fontSize: 11, color: MUTED_TEXT, textAlign: "right" }}>{countStr}</Text>
    </Row>
  )
}

fn NotesSidebarSharedRow() {
  return (
    <Row
      columnWidths={NOTES_SIDEBAR_COL_WIDTHS}
      weights={NOTES_SIDEBAR_WEIGHTS}
      style={{
        paddingTop: 5,
        paddingBottom: 6,
        paddingLeft: SIDEBAR_ROW_INSET,
        paddingRight: SIDEBAR_ROW_INSET,
        backgroundColor: "transparent",
        alignItems: "center",
      }}
    >
      <Image src={"person.crop.circle"} symbol={true} height={16} symbolScale="small" tint={"label"} />
      <Text style={{ fontSize: 13, color: "label" }}>{"Shared"}</Text>
      <Text style={{ fontSize: 11, color: MUTED_TEXT, textAlign: "right" }}>{"78"}</Text>
    </Row>
  )
}

fn note_row_style(note, i) {
  if (note === i) {
    return {
      height: 48,
      bezelStyle: "borderless",
      backgroundColor: "#ffffff12",
      borderRadius: 4,
      paddingLeft: 6,
      paddingRight: 6,
    }
  }
  return {
    height: 48,
    bezelStyle: "borderless",
    backgroundColor: "transparent",
    borderRadius: 4,
    paddingLeft: 6,
    paddingRight: 6,
  }
}

fn App() {
  let [folder, setFolder] = useState(0)
  let [note, setNote] = useState(0)

  let folder_names = ["All iCloud", "Notes", "Pitch", "Quick Notes"]
  let folder_nums = ["1,682", "1,477", "205", "0"]
  let note_titles = ["Ascii", "Release checklist", "Ideas"]
  let note_meta = [
    "Apr 9, 2026 · https://example.com …",
    "Yesterday · Stand-up notes",
    "Mon · Short list",
  ]
  let note_bodies = [
    "https://example.com\nhttps://developer.apple.com\n\nPaste more links here.",
    "• Final QA\n• Tag build\n• Notify channel",
    "• Sketch sidebar polish\n• Semantic colors in style{}",
  ]

  let [editorBody, setEditorBody] = useState(note_bodies[0])

  useEffect(
    () => {
      setEditorBody(note_bodies[note])
    },
    [note]
  )

  let folder_title = folder_names[folder]
  let folder_count = folder_nums[folder]

  return (
    <SidebarWindow
      appearance={"darkAqua"}
      toolbarItems={[
        { symbol: "square.and.pencil", id: "compose", label: "New Note" },
        { symbol: "textformat", id: "format", label: "Format" },
        { symbol: "checklist", id: "checklist", label: "Checklist" },
        { symbol: "tablecells", id: "table", label: "Table" },
        { symbol: "paperclip", id: "attach", label: "Attach" },
        { symbol: "pencil.and.scribble", id: "markup", label: "Markup" },
        { symbol: "square.and.arrow.up", id: "share", label: "Share" },
        { symbol: "ellipsis.circle", id: "more", label: "More" },
        "FlexibleSpace",
        { symbol: "folder.badge.plus", id: "newFolder", label: "New Folder" },
        "ToolbarSpace",
        "ToolbarSidebarToggle",
      ]}
      onToolbarAction={(id) => {}}
      sidebarToolbarToggle={true}
      sidebarTrackingSeparator={false}
      sidebarMinWidth={268}
      sidebarPreferredWidthFraction={0.215}
    >
      <VisualEffect
        height={"fill"}
        material={SIDEBAR_EFFECT_MATERIAL}
        blendingMode={SIDEBAR_EFFECT_BLENDING}
        style={{ opacity: GLASS_OPACITY }}
      >
        <ScrollView
          height={"fill"}
          direction="vertical"
          drawsBackground={false}
          style={{
            backgroundColor: "transparent",
            paddingLeft: SIDEBAR_SCROLL_PL,
            paddingRight: 6,
            paddingTop: 2,
            paddingBottom: 6,
          }}
        >
          {NotesSidebarSharedRow()}

          <Text
            style={{
              fontSize: 11,
              fontWeight: "medium",
              color: SECTION_HEADER_COLOR,
              paddingTop: 10,
              paddingBottom: 5,
              paddingLeft: SIDEBAR_SCROLL_PL + SIDEBAR_ROW_INSET,
            }}
          >
            {"iCloud"}
          </Text>

          {NotesSidebarFolderRow(folder, 0, folder_names[0], folder_nums[0], () => setFolder(0))}
          {NotesSidebarFolderRow(folder, 1, folder_names[1], folder_nums[1], () => setFolder(1))}
          {NotesSidebarFolderRow(folder, 2, folder_names[2], folder_nums[2], () => setFolder(2))}
          {NotesSidebarFolderRow(folder, 3, folder_names[3], folder_nums[3], () => setFolder(3))}
        </ScrollView>
      </VisualEffect>

      <Split height={"fill"} orientation="horizontal" dividerStyle="thin" dividerPosition={280}>
        <VisualEffect
          height={"fill"}
          material={PANE_EFFECT_MATERIAL}
          blendingMode={PANE_EFFECT_BLENDING}
          emphasized={true}
          style={{ opacity: GLASS_OPACITY }}
        >
          <ScrollView
            height={"fill"}
            direction="vertical"
            drawsBackground={false}
            style={{ backgroundColor: "transparent", paddingLeft: 12, paddingRight: 10, paddingTop: 8 }}
          >
            <Text style={{ fontSize: 15, fontWeight: "semibold", color: "label" }}>{folder_title}</Text>
            <Text style={{ fontSize: 11, color: "secondaryLabel", paddingBottom: 10 }}>
              {folder_count + " notes"}
            </Text>

            <Text style={{ fontSize: 11, fontWeight: "semibold", color: "tertiaryLabel", paddingBottom: 6 }}>
              {"Previous 7 Days"}
            </Text>

            <Button style={note_row_style(note, 0)} onClick={() => setNote(0)}>
              {note_titles[0] + "\n" + note_meta[0]}
            </Button>
            <Button style={note_row_style(note, 1)} onClick={() => setNote(1)}>
              {note_titles[1] + "\n" + note_meta[1]}
            </Button>
            <Button style={note_row_style(note, 2)} onClick={() => setNote(2)}>
              {note_titles[2] + "\n" + note_meta[2]}
            </Button>
          </ScrollView>
        </VisualEffect>

        <VisualEffect
          height={"fill"}
          material={PANE_EFFECT_MATERIAL}
          blendingMode={PANE_EFFECT_BLENDING}
          emphasized={true}
          style={{ opacity: GLASS_OPACITY }}
        >
          <ScrollView
            height={"fill"}
            direction="vertical"
            drawsBackground={false}
            style={{ backgroundColor: "transparent", paddingLeft: 16, paddingRight: 16, paddingTop: 8 }}
          >
            <Text
              style={{
                fontSize: 11,
                color: "secondaryLabel",
                wrap: true,
                paddingBottom: 8,
              }}
            >
              {"April 12, 2026 at 3:00 PM"}
            </Text>

            <Text style={{ fontSize: 22, fontWeight: "bold", color: "label", paddingBottom: 8 }}>
              {note_titles[note]}
            </Text>

            <TextEditor
              minHeight={360}
              fontSize={14}
              value={editorBody}
              onChange={(s) => setEditorBody(s)}
            />
          </ScrollView>
        </VisualEffect>
      </Split>
    </SidebarWindow>
  )
}

macos.run(App, { title: "Notes", appearance: "darkAqua" })
