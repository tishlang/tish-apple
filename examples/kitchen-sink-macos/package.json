{
  "name": "kitchen-sink-macos",
  "private": true,
  "type": "module",
  "description": "Exercises @tishlang/tish-macos widgets + window API",
  "dependencies": {
    "@tishlang/tish": "^2.39.0",
    "@tishlang/tish-macos": "^0.2.0"
  },
  "scripts": {
    "build": "tish build --target native --native-backend rust src/main.tish -o dist/kitchen-sink-macos",
